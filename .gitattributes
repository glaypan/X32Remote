# iOS 工程在 macOS 上编译，源文件统一用 LF。
# Windows 下 git 默认 autocrlf=true 会把 LF 转成 CRLF，
# 虽然 Swift 编译器不在意，但会让 pbxproj / scheme 的 diff 产生大量噪音。
* text=auto eol=lf

*.swift      text eol=lf
*.pbxproj    text eol=lf
*.xcscheme   text eol=lf
*.xcworkspacedata text eol=lf
*.yml        text eol=lf
*.yaml       text eol=lf
*.py         text eol=lf
*.md         text eol=lf
*.json       text eol=lf

# 二进制，别碰
*.png  binary
*.jpg  binary
*.ipa  binary
*.zip  binary
